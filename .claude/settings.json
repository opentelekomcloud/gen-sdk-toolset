{
  "permissions": {
    "allow": [
      "Bash(uv run pytest*)",
      "Bash(uv run diff-cover*)",
      "Bash(uv run gen-sdk-scan*)",
      "Bash(uv run panel*)",
      "Bash(uv run alembic*)",
      "Bash(uv sync*)",
      "Bash(ruff check*)",
      "Bash(ruff format*)",
      "Bash(lint-imports*)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(gh issue view*)",
      "Bash(gh issue list*)",
      "Bash(gh pr view*)",
      "Bash(gh pr diff*)",
      "Bash(npm run lint*)",
      "Bash(npm run build*)",
      "Bash(npm run test*)"
    ],
    "deny": [
      "Read(.env)",
      "Bash(git push --force*)",
      "Bash(git reset --hard*)",
      "Bash(rm -rf*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "uv run --quiet python \"${CLAUDE_PROJECT_DIR}/.claude/hooks/guard_paths.py\"",
            "timeout": 15
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "uv run --quiet python \"${CLAUDE_PROJECT_DIR}/.claude/hooks/format_edited.py\"",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
