# ODS registry (issue #135). This file is committed and the repository is
# public: the token comes only from ODS_NPM_TOKEN in the environment (see
# frontend/README.md, "ODS packages"). Not `${ODS_NPM_TOKEN?}`: npm 10 (Node 22 -
# the dev image and CI) does not know that form and sends it as the token.
@telekom-ods:registry=https://artifactory.devops.telekom.de/artifactory/api/npm/one-design-system-npm/
//artifactory.devops.telekom.de/artifactory/api/npm/one-design-system-npm/:_authToken=${ODS_NPM_TOKEN}
ignore-scripts=false
foreground-scripts=true
