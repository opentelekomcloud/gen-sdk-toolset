# ODS (OneExperience Design System) packages come from the Magenta CI/CD JFrog
# registry (issue #135). This file only names the registry; the credential is
# never committed. Locally it lives in your user-level ~/.npmrc (see
# frontend/README.md); CI writes it into the job's npm config from a secret.
@telekom-ods:registry=https://artifactory.devops.telekom.de/artifactory/api/npm/one-design-system-npm/
ignore-scripts=false
foreground-scripts=true
