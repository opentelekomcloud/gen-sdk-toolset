# Frontend for a deployed panel: a static bundle, not the dev server.
#
# The compose stack runs Vite in dev mode with the sources mounted, which is
# right for a laptop and wrong for anything reachable from the internet: it
# ships source maps, watches the filesystem and serves unminified modules.
FROM node:22-alpine AS build
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci
COPY . .
# The bundle talks to /api on its own origin; Caddy proxies that to the backend,
# so no build-time backend URL is needed. Zitadel is different: Vite inlines
# VITE_* at build time, so the issuer and client id have to be here rather than
# in the runtime environment - hence the build args.
ARG VITE_ZITADEL_ISSUER=""
ARG VITE_ZITADEL_CLIENT_ID=""
ARG VITE_ZITADEL_SCOPE=""
ENV VITE_ZITADEL_ISSUER=$VITE_ZITADEL_ISSUER \
    VITE_ZITADEL_CLIENT_ID=$VITE_ZITADEL_CLIENT_ID \
    VITE_ZITADEL_SCOPE=$VITE_ZITADEL_SCOPE
RUN npm run build

FROM caddy:2-alpine
COPY --from=build /app/dist /srv
