# Copy to deploy/.env on the host and fill in. Nothing here is committed.
POSTGRES_PASSWORD=change-me
# A domain (Caddy then gets a certificate automatically) or ":80" without one.
SITE_ADDRESS=:80
SITE_URL=http://localhost
# Where the stack listens on this host. Leave at 80/443 on a server; use 8080
# on a laptop that already runs the development stack.
HTTP_PORT=80
HTTPS_PORT=443
# Read by the scheduled discovery pass only (see README). The API server stays
# without a token on purpose, so a rescan started from the UI on this host still
# cannot reach GitHub - scans remain a laptop activity. Leave empty to run no
# scheduled sync at all.
GITHUB_TOKEN=
