# TLS and static files. Authentication is the API's own: every route under
# /api requires a Zitadel bearer token, and the panel signs the user in itself.
#
# There used to be a shared basic-auth password here, from before the API had
# any authentication. It cannot stay: a request carries one Authorization
# header, so a browser sending `Bearer ...` fails Caddy's `Basic` challenge and
# never reaches the backend at all.
#
# SITE_ADDRESS is the domain (Caddy then obtains a Let's Encrypt certificate on
# its own) or :80 when there is no DNS name yet.
{$SITE_ADDRESS} {
	# The API and the health probe live on the backend; everything else is the
	# static bundle, with unknown paths falling back to index.html so the
	# client-side router keeps working on a deep link.
	handle /api/* {
		reverse_proxy backend:8000
	}
	handle /health {
		reverse_proxy backend:8000
	}
	# Still proxied although the backend no longer serves them: these are API
	# paths, so a 404 from the API is the honest answer. Dropping the handlers
	# would send them to the SPA fallback below, which answers 200 with the
	# panel's own not-found page.
	handle /docs* {
		reverse_proxy backend:8000
	}
	handle /redoc* {
		reverse_proxy backend:8000
	}
	handle /openapi.json {
		reverse_proxy backend:8000
	}
	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}

	encode gzip
	log {
		output stdout
		format console
	}
}
