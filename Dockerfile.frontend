# The panel UI as a deployable image: the built bundle behind nginx.
#
# Build context is ./frontend (see the frontend service in docker-compose.yml
# for the dev-server image, which this is not):
#
#   docker build -f Dockerfile.frontend --build-arg ARTIFACTORY_URL=... \
#     --secret id=ods_npm_token,env=ODS_NPM_TOKEN -t panel-frontend ./frontend
#
# The ODS packages (issue #135) need the token as the BuildKit secret
# `ods_npm_token`; frontend/.npmrc reads it as ODS_NPM_TOKEN.
#
# Both stages come from the organization's Artifactory mirror of Docker
# Hardened Images (DEPLOYMENT.md, "Building the images"). The hardened nginx
# listens on 8080 and runs as the nginx user (uid 101), not as root.
#
# No Zitadel value is baked in. The bundle is the same for every deployment;
# at container start `docker/panel-config.sh` writes /config.js from the
# ZITADEL_ISSUER, ZITADEL_CLIENT_ID and ZITADEL_SCOPE environment variables,
# and the app reads that file before anything else (src/shared/auth/config.ts).
#
# /api is not served here. The ingress in front routes /api/* to the backend
# and everything else to this container; nginx answers 404 for /api so a
# missing route shows up as one instead of as the panel's own not-found page.
ARG ARTIFACTORY_URL
FROM ${ARTIFACTORY_URL}/dhi.io/node:24-alpine-dev AS build
WORKDIR /app
COPY package.json package-lock.json .npmrc ./
RUN --mount=type=secret,id=ods_npm_token,required=true \
    ODS_NPM_TOKEN="$(cat /run/secrets/ods_npm_token)" npm ci
COPY . .
RUN npm run build

FROM ${ARTIFACTORY_URL}/dhi.io/nginx:1-alpine-dev
COPY docker/nginx.conf /etc/nginx/conf.d/default.conf
# --chmod: a checkout on Windows carries no executable bit.
COPY --chmod=755 docker/panel-config.sh /panel-config.sh
COPY --from=build /app/dist /usr/share/nginx/html
USER 101
EXPOSE 8080
CMD ["sh", "-c", "/panel-config.sh && exec nginx -g 'daemon off;'"]
