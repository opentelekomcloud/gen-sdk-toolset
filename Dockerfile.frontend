# The panel UI as a deployable image: the built bundle behind nginx.
#
# Build context is ./frontend (see the frontend service in docker-compose.yml
# for the dev-server image, which this is not):
#
#   docker build -f Dockerfile.frontend -t panel-frontend ./frontend
#
# No Zitadel value is baked in. The bundle is the same for every deployment;
# at container start `docker/10-panel-config.sh` writes /config.js from the
# ZITADEL_ISSUER, ZITADEL_CLIENT_ID and ZITADEL_SCOPE environment variables,
# and the app reads that file before anything else (src/shared/auth/config.ts).
#
# /api is not served here. The ingress in front routes /api/* to the backend
# and everything else to this container; nginx answers 404 for /api so a
# missing route shows up as one instead of as the panel's own not-found page.
FROM node:22-alpine AS build
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci
COPY . .
RUN npm run build

FROM nginx:1.27-alpine
COPY docker/nginx.conf /etc/nginx/conf.d/default.conf
# The official image runs every *.sh in this directory before nginx starts.
COPY docker/10-panel-config.sh /docker-entrypoint.d/10-panel-config.sh
RUN chmod +x /docker-entrypoint.d/10-panel-config.sh
COPY --from=build /app/dist /usr/share/nginx/html
EXPOSE 80
