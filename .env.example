GITHUB_TOKEN=ghp_your_token

# Panel database (PostgreSQL). Matches the docker-compose db service defaults.
DATABASE__URL=postgresql+psycopg://panel:panel@localhost:5432/panel

# Zitadel OIDC. The panel validates every bearer token against this issuer and
# refuses to serve `/api` at all while either value is missing - it has nothing
# to check a token with. The audience is the panel application's client id.
AUTH__ISSUER=https://your-instance.zitadel.cloud
AUTH__AUDIENCE=123456789@your_project

# The panel UI's Zitadel application (SPA, PKCE, no client secret). Vite inlines
# these at build time, so a changed value needs a rebuilt frontend. The scope
# must include this project's role scope, or every session looks role-less:
#   urn:zitadel:iam:org:project:id:<project id>:aud
VITE_ZITADEL_ISSUER=https://your-instance.zitadel.cloud
VITE_ZITADEL_CLIENT_ID=123456789@your_project
# Add `offline_access` if the Zitadel application issues refresh tokens; without
# it the silent renew falls back to a hidden iframe against the redirect URI.
VITE_ZITADEL_SCOPE=openid profile email urn:zitadel:iam:org:project:id:<project id>:aud
