# The API, with the scanner inside it. Also the discovery CronJob's image.
#
# The base image comes from the organization's Artifactory mirror of Docker
# Hardened Images, so a build needs ARTIFACTORY_URL and a `docker login` to
# it - see DEPLOYMENT.md, "Building the images". The `-dev` variant is used
# at runtime on purpose: the hardened runtime image has no shell, and this
# container starts through one (migrations, then the server).
ARG ARTIFACTORY_URL
FROM ${ARTIFACTORY_URL}/dhi.io/python:3.13-dev

# uv from PyPI rather than copied out of a third-party image.
RUN pip install --no-cache-dir uv==0.8.17

WORKDIR /app

COPY pyproject.toml uv.lock README.md alembic.ini ./
RUN uv sync --extra panel --frozen --no-install-project

COPY src ./src
RUN uv sync --extra panel --frozen

EXPOSE 8000

# Apply pending migrations before serving so the container is usable on a
# fresh (or upgraded) database.
CMD ["sh", "-c", "uv run alembic upgrade head && uv run uvicorn tools.panel.api.app:create_app --factory --host 0.0.0.0 --port 8000"]
